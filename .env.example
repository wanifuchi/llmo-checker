# LLMO Checker Environment Variables

# SerpAPI (無料枠: 月100回)
# https://serpapi.com/ でアカウント作成後、APIキーを取得
SERP_API_KEY=your_serpapi_key_here

# Google PageSpeed Insights API
# 現在は認証不要でリクエスト制限のみ
# 必要に応じて Google Cloud Console でAPIキーを設定
# GOOGLE_PAGESPEED_API_KEY=your_google_api_key_here

# その他の外部API（オプション）
# Ahrefs API (有料)
# AHREFS_API_TOKEN=your_ahrefs_token_here

# SEMrush API (有料)
# SEMRUSH_API_KEY=your_semrush_key_here

# 分析設定
NEXT_PUBLIC_ENABLE_EXTERNAL_APIS=true
NEXT_PUBLIC_MAX_COMPETITOR_SITES=5
NEXT_PUBLIC_ANALYSIS_TIMEOUT=30000

# 開発環境設定
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000